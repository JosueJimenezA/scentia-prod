# Imagen base con Python 3.11 garantizado
FROM python:3.11-slim

WORKDIR /app

# Instalar dependencias necesarias para compilar y ejecutar navegadores
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Copiamos e instalamos tus requerimientos
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Instalar Chromium y sus dependencias de sistema operativo automáticamente
RUN playwright install --with-deps chromium

# Copiamos todo el código del backend
COPY . .

ENV PORT=10000
EXPOSE $PORT

CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT}"]